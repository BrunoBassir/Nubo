rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /places/{document=**} {
      allow read, write: if true;
    }
    
    match /challenges/{document=**} {
      allow read, write: if true;
    }

    match /rewards/{document=**} {
      allow read, write: if true;
    }
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
